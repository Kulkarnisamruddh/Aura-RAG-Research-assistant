# ===========================================
# Aura RAG Assistant — Environment Variables
# ===========================================
# Copy this file to .env and fill in your real keys:
#   cp .env.example .env
#
# NEVER commit the .env file to git.
# ===========================================

# Backend API URL (used by the Vite frontend)
VITE_API_URL=http://localhost:3001/api/chat

# Groq API Key — get one at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Supabase — get these from your Supabase project dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# OpenRouter (if used) — get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here
